# Copy to .env for local builds. Never commit real values.
SITE_URL=https://redproject.id
BASE_PATH=/
# "live" posts the contact form to /api/contact.php (production on DomaiNesia).
# "demo" shows a notice instead (GitHub Pages staging has no PHP).
PUBLIC_FORM_MODE=live
# Optional analytics. Leave empty until the GTM container has been audited.
PUBLIC_GTM_ID=
