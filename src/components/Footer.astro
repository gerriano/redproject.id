---
import { Image } from 'astro:assets';
import logoWhite from '../assets/brand/logo-white.png';
import { site, nav, waLink, marquee } from '../data/site';
import { url } from '../lib/url';
import Arrow from './Arrow.astro';

interface Props { cta?: boolean }
const { cta = true } = Astro.props;
const year = new Date().getFullYear();
---
<footer class:list={["site-footer section--dark", { "site-footer--compact": !cta }]}>
  {cta && (
    <div class="container footer-cta">
      <p class="eyebrow">Free · No obligation · Up to 60 minutes</p>
      <h2 class="footer-cta__title" data-split>Let's grow your<br />business <span class="nowrap">further<span class="red">.</span></span></h2>
      <div class="footer-cta__actions" data-reveal>
        <a href={waLink()} class="btn btn--red" target="_blank" rel="noopener" data-magnetic data-cursor>
          Book on WhatsApp <Arrow />
        </a>
        <a href={url('/contact/')} class="btn btn--ghost" data-magnetic data-cursor>Send us a brief <Arrow /></a>
      </div>
    </div>
  )}

  <div class="marquee footer-marquee" aria-hidden="true" style="--marquee-speed: 46s">
    {[0, 1].map(() => (
      <div class="marquee__track">
        {marquee.map((m) => (<span class="footer-marquee__item">{m}<i>✳</i></span>))}
      </div>
    ))}
  </div>

  <div class="container footer-grid">
    <div class="footer-brand">
      <Image src={logoWhite} alt="RED Project" width={130} height={71} />
      <p class="muted">Digital advisory 360° for businesses that want results they can measure.</p>
    </div>
    <div>
      <p class="mono muted">Navigate</p>
      <ul role="list">
        {nav.map((n) => (<li><a href={url(n.href)} class="link-underline">{n.label}</a></li>))}
        <li><a href={url('/privacy/')} class="link-underline">Privacy</a></li>
      </ul>
    </div>
    <div>
      <p class="mono muted">Contact</p>
      <ul role="list">
        <li><a href={`mailto:${site.email}`} class="link-underline">{site.email}</a></li>
        <li><a href={waLink()} target="_blank" rel="noopener" class="link-underline">WhatsApp {site.whatsapp.display}</a></li>
        <li class="muted">{site.location}</li>
      </ul>
    </div>
    <div>
      <p class="mono muted">Follow</p>
      <ul role="list">
        {site.social.map((s) => (<li><a href={s.href} target="_blank" rel="noopener" class="link-underline">{s.label}</a></li>))}
      </ul>
    </div>
  </div>

  <div class="container footer-bottom mono">
    <span>© {year} {site.legalName}</span>
    <a href="#main" class="link-underline" data-scroll-top>Back to top ↑</a>
  </div>
</footer>

<style>
  .site-footer { padding-top: var(--section); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 28px); overflow: hidden; }
  .site-footer--compact { padding-top: 0; }
  .footer-cta { display: grid; gap: 32px; padding-bottom: var(--section); }
  .footer-cta__title { font-weight: 800; font-size: clamp(3rem, 1.4rem + 7vw, 9rem); line-height: 0.88; letter-spacing: -0.045em; text-transform: uppercase; }
  .footer-cta__actions { display: flex; flex-wrap: wrap; gap: 14px; }
  .footer-marquee { border-block: 1px solid var(--rule-on-dark); padding-block: 22px; }
  .footer-marquee__item { display: inline-flex; align-items: center; gap: 36px; padding-right: 36px; font-weight: 700; font-size: var(--step-3); letter-spacing: -0.03em; text-transform: uppercase; }
  .footer-marquee__item i { font-style: normal; color: var(--red); font-size: 0.6em; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1.4fr 1fr; gap: 40px; padding-block: 72px 56px; }
  .footer-grid ul { display: grid; gap: 8px; margin-top: 16px; }
  .footer-brand { display: grid; gap: 18px; align-content: start; max-width: 32ch; }
  .footer-brand img { width: 120px; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding-top: 24px; border-top: 1px solid var(--rule-on-dark); color: var(--muted-on-dark); }
  @media (max-width: 900px) { .footer-grid { grid-template-columns: 1fr 1fr; } .footer-brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .footer-grid { grid-template-columns: 1fr; } }
</style>
