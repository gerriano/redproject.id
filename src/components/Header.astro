---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo-black.png';
import logoWhite from '../assets/brand/logo-white.png';
import { nav, waLink } from '../data/site';
import { url } from '../lib/url';
---
<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={url('/')} class="brand" aria-label="RED Project, home">
      <Image src={logo} alt="" width={120} height={66} loading="eager" class="brand__img" />
    </a>

    <nav class="primary-nav" aria-label="Primary">
      <ul role="list">
        {nav.map((item) => (
          <li><a href={url(item.href)} class="link-underline" data-cursor>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a href={waLink()} class="btn btn--red header-cta" target="_blank" rel="noopener" data-magnetic data-cursor>
      Free consultation
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden">Open menu</span>
      <span class="menu-toggle__bar"></span>
      <span class="menu-toggle__bar"></span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <div class="container mobile-menu__inner">
      <Image src={logoWhite} alt="" width={110} height={60} class="mobile-menu__logo" />
      <ul role="list" class="mobile-menu__list">
        {nav.map((item, i) => (
          <li style={`--i:${i}`}><a href={url(item.href)} data-menu-link>{item.label}</a></li>
        ))}
      </ul>
      <a href={waLink()} class="btn btn--red" target="_blank" rel="noopener">Book a free consultation</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto; z-index: 100;
    padding-top: env(safe-area-inset-top, 0px);
    transition: transform 0.5s var(--ease-out), background-color 0.4s, box-shadow 0.4s;
  }
  .site-header.is-scrolled { background: color-mix(in srgb, var(--paper) 86%, transparent); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--rule); }
  .site-header.is-hidden { transform: translateY(-100%); }
  .site-header__inner { height: var(--header-h); display: flex; align-items: center; gap: 32px; }
  .brand { display: block; flex-shrink: 0; }
  .brand__img { width: 96px; height: auto; }
  .primary-nav { margin-left: auto; }
  .primary-nav ul { display: flex; gap: 32px; }
  .primary-nav a { font-weight: 600; font-size: 0.95rem; padding-block: 4px; }
  .header-cta { min-height: 46px; padding: 0 22px; font-size: 0.95rem; }

  .menu-toggle { display: none; position: relative; z-index: 2; width: 48px; height: 48px; margin-left: auto; border-radius: 50%; background: var(--ink); }
  .menu-toggle__bar { position: absolute; left: 14px; right: 14px; height: 2px; background: var(--white); transition: transform 0.45s var(--ease-out); }
  .menu-toggle__bar:nth-of-type(2) { transform: translateY(-4px); }
  .menu-toggle__bar:nth-of-type(3) { transform: translateY(4px); }
  .menu-open .menu-toggle { background: var(--red); }
  .menu-open .menu-toggle__bar:nth-of-type(2) { transform: rotate(45deg); }
  .menu-open .menu-toggle__bar:nth-of-type(3) { transform: rotate(-45deg); }

  .mobile-menu { position: fixed; inset: 0; z-index: 1; background: var(--ink); color: var(--white); overflow-y: auto; }
  .mobile-menu__inner { min-height: 100%; display: flex; flex-direction: column; gap: 40px; padding-top: calc(env(safe-area-inset-top, 0px) + 20px); padding-bottom: calc(env(safe-area-inset-bottom, 0px) + 40px); }
  .mobile-menu__logo { width: 90px; }
  .mobile-menu__list { display: grid; gap: 4px; margin-top: auto; }
  .mobile-menu__list a { display: block; font-weight: 800; font-size: clamp(2.6rem, 12vw, 4.5rem); line-height: 1.02; letter-spacing: -0.04em; text-transform: uppercase; }
  .mobile-menu__list a:active { color: var(--red); }
  .mobile-menu:not([hidden]) .mobile-menu__list li { animation: menu-in 0.7s var(--ease-out) both; animation-delay: calc(var(--i) * 70ms + 80ms); }
  .mobile-menu .btn { align-self: flex-start; }
  @keyframes menu-in { from { opacity: 0; transform: translateY(40px); } }

  @media (max-width: 900px) {
    .primary-nav, .header-cta { display: none; }
    .menu-toggle { display: block; }
    .brand__img { width: 84px; }
  }
</style>
