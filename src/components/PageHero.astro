---
import { Image } from 'astro:assets';

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  image?: ImageMetadata;
}
const { eyebrow, title, lead, image } = Astro.props;
const words = title.split(' ');
---
<section class="page-hero">
  <div class="container page-hero__inner">
    <p class="eyebrow" data-hero-fade>{eyebrow}</p>
    <h1 class="display page-hero__title" aria-label={title}>
      {words.map((w) => (<span class="hero__line"><span class="hero__line-inner">{w}</span></span>))}
    </h1>
    {lead && <p class="lead page-hero__lead" data-hero-fade>{lead}</p>}
    <slot />
  </div>
  {image && (
    <div class="page-hero__media">
      <div class="page-hero__media-inner" data-parallax>
        <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" />
      </div>
    </div>
  )}
</section>

<style>
  .page-hero { padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(40px, 7vw, 100px)); }
  .page-hero__inner { display: grid; gap: clamp(20px, 3vw, 36px); padding-bottom: clamp(48px, 7vw, 100px); }
  .page-hero__title { display: flex; flex-wrap: wrap; column-gap: 0.25em; }
  .page-hero__title :global(.hero__line) { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .page-hero__title :global(.hero__line-inner) { display: inline-block; }
  .page-hero__lead { max-width: 44ch; }
  .page-hero__media { position: relative; height: clamp(320px, 62vh, 680px); overflow: hidden; background: var(--ink); }
  .page-hero__media-inner { position: absolute; inset: -10% 0; }
  .page-hero__media img { width: 100%; height: 100%; object-fit: cover; }
</style>
