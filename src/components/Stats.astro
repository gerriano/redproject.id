---
import { stats } from '../data/site';
---
<section class="section stats" aria-labelledby="stats-title">
  <div class="container">
    <div class="stats__head">
      <p class="eyebrow">In numbers</p>
      <h2 class="h3" id="stats-title" data-split>A decade of helping brands grow online.</h2>
    </div>
    <dl class="stats__grid">
      {stats.map((s) => (
        <div class="stat" data-reveal>
          <dt class="mono muted">{s.label}</dt>
          <dd class="stat__value"><span data-count={s.value}>{s.value}</span><span class="red">{s.suffix}</span></dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .stats__head { display: grid; gap: 20px; margin-bottom: clamp(40px, 5vw, 72px); }
  .stats__head .h3 { max-width: 20ch; }
  .stats__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 1px solid var(--ink); }
  .stat { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 12px; padding: 28px 24px 8px 0; }
  .stat + .stat { padding-left: 24px; border-left: 1px solid var(--rule); }
  .stat__value { font-weight: 800; font-size: var(--step-4); line-height: 0.9; letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  @media (max-width: 860px) {
    .stats__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { padding-left: 0; border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--rule); }
  }
</style>
