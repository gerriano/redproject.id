---
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import { url } from '../lib/url';
---
<Base title="Page not found" path="/404/" noindex footerCta={false}>
  <section class="simple">
    <div class="container simple__inner">
      <p class="eyebrow" data-hero-fade>Error 404</p>
      <h1 class="display" aria-label="Page not found">
        <span class="hero__line"><span class="hero__line-inner">Lost</span></span>
        <span class="hero__line"><span class="hero__line-inner">the page<span class="red">.</span></span></span>
      </h1>
      <p class="lead" data-hero-fade>This page doesn't exist, or it moved when we rebuilt the site. Everything that matters is one click away.</p>
      <div class="simple__actions" data-hero-fade>
        <a href={url('/')} class="btn btn--red" data-magnetic>Go to home <Arrow /></a>
        <a href={url('/contact/')} class="btn btn--ghost">Contact us</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .simple { min-height: 80vh; display: grid; align-items: center; padding-top: calc(var(--header-h) + 60px); padding-bottom: var(--section); }
  .simple__inner { display: grid; gap: 28px; }
  .simple h1 :global(.hero__line) { display: block; overflow: hidden; }
  .simple h1 :global(.hero__line-inner) { display: inline-block; }
  .simple__actions { display: flex; flex-wrap: wrap; gap: 12px; }
</style>
