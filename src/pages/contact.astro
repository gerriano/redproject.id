---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { site, waLink, practices } from '../data/site';
import { url } from '../lib/url';

const formMode = import.meta.env.PUBLIC_FORM_MODE === 'demo' ? 'demo' : 'live';
const interests = practices.flatMap((p) => p.services.map((s) => s.title));
---
<Base
  title="Contact"
  path="/contact/"
  description="Book a free consultation with RED Project on WhatsApp, or send us a brief. We reply within one working day."
  footerCta={false}
>
  <PageHero
    eyebrow="Contact"
    title="Let's talk"
    lead="The fastest route is a free consultation on WhatsApp. Prefer writing? Send a brief and we'll reply within one working day."
  />

  <section class="contact">
    <div class="container contact__grid">
      <aside class="contact__aside">
        <a href={waLink()} class="wa-card" target="_blank" rel="noopener" data-cursor data-reveal>
          <span class="mono">Recommended</span>
          <strong>Free consultation on WhatsApp</strong>
          <span class="muted">No cost · Flexible schedule · Google Meet · Up to 60 minutes</span>
          <span class="wa-card__cta">Chat now <Arrow /></span>
        </a>
        <dl class="contact__details" data-reveal>
          <div><dt class="mono muted">Email</dt><dd><a href={`mailto:${site.email}`} class="link-underline">{site.email}</a></dd></div>
          <div><dt class="mono muted">WhatsApp</dt><dd><a href={waLink()} target="_blank" rel="noopener" class="link-underline">{site.whatsapp.display}</a></dd></div>
          <div><dt class="mono muted">Based in</dt><dd>{site.location}</dd></div>
          <div><dt class="mono muted">Follow</dt><dd class="contact__social">{site.social.map((s) => (<a href={s.href} target="_blank" rel="noopener" class="link-underline">{s.label}</a>))}</dd></div>
        </dl>
      </aside>

      <form
        class="brief"
        method="post"
        action={url('/api/contact.php')}
        data-contact-form
        data-mode={formMode}
        data-success={url('/thank-you/')}
        novalidate
      >
        <h2 class="h3">Send a brief</h2>
        <div class="brief__row">
          <div class="field">
            <label for="f-name">Name <span aria-hidden="true">*</span></label>
            <input id="f-name" name="name" type="text" autocomplete="name" required maxlength="100" />
          </div>
          <div class="field">
            <label for="f-company">Company</label>
            <input id="f-company" name="company" type="text" autocomplete="organization" maxlength="120" />
          </div>
        </div>
        <div class="brief__row">
          <div class="field">
            <label for="f-email">Email <span aria-hidden="true">*</span></label>
            <input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160" />
          </div>
          <div class="field">
            <label for="f-phone">WhatsApp number</label>
            <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="+62" />
          </div>
        </div>
        <div class="field">
          <label for="f-interest">What do you need help with?</label>
          <select id="f-interest" name="interest">
            <option value="">Not sure yet</option>
            {interests.map((i) => (<option value={i}>{i}</option>))}
          </select>
        </div>
        <div class="field">
          <label for="f-message">Tell us about your business and goals <span aria-hidden="true">*</span></label>
          <textarea id="f-message" name="message" rows="6" required minlength="10" maxlength="4000"></textarea>
        </div>

        <div class="hp" aria-hidden="true">
          <label for="f-website">Leave this field empty</label>
          <input id="f-website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <input type="hidden" name="ts" value="" data-ts />

        <label class="consent" for="f-consent">
          <input id="f-consent" name="consent" type="checkbox" value="yes" required />
          <span>I agree that RED Project may use these details to reply to my enquiry, as described in the <a href={url('/privacy/')} class="link-underline red">privacy notice</a>.</span>
        </label>

        <p class="brief__status" role="status" aria-live="polite" data-status></p>
        <button type="submit" class="btn btn--red" data-magnetic data-cursor>
          <span data-label>Send brief</span> <Arrow />
        </button>
      </form>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const ts = form.querySelector<HTMLInputElement>('[data-ts]');
    if (ts) ts.value = String(Math.floor(Date.now() / 1000));

    const setStatus = (msg: string, kind: 'error' | 'info' | '' = '') => {
      status.textContent = msg;
      status.dataset.kind = kind;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      setStatus('');
      form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));

      const invalid = Array.from(form.querySelectorAll<HTMLInputElement>('input, textarea, select')).filter((el) => !el.checkValidity());
      if (invalid.length) {
        invalid.forEach((el) => el.setAttribute('aria-invalid', 'true'));
        invalid[0].focus();
        setStatus('Please fill in your name, a valid email, a short message and tick the consent box.', 'error');
        return;
      }

      if (form.dataset.mode === 'demo') {
        setStatus('This is the staging preview, so the form is not connected yet. Please use WhatsApp or email for now.', 'info');
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      label.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const data = await res.json().catch(() => ({}));
        if (res.ok && data.ok) {
          window.location.href = form.dataset.success || '/thank-you/';
          return;
        }
        setStatus(data.error || 'Something went wrong on our side. Please try again, or reach us on WhatsApp.', 'error');
      } catch {
        setStatus('We could not reach the server. Check your connection and try again, or reach us on WhatsApp.', 'error');
      }
      button.disabled = false;
      label.textContent = 'Send brief';
    });
  }
</script>

<style>
  .contact { padding-bottom: var(--section); }
  .contact__grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(32px, 6vw, 112px); align-items: start; }
  .contact__aside { display: grid; gap: 40px; position: sticky; top: calc(var(--header-h) + 32px); }
  .wa-card { display: grid; gap: 10px; padding: 28px; background: var(--ink); color: var(--white); border-radius: 6px; transition: background-color 0.4s; }
  .wa-card strong { font-size: var(--step-2); font-weight: 800; line-height: 1.05; letter-spacing: -0.03em; }
  .wa-card .muted { color: var(--muted-on-dark); font-size: var(--step--1); }
  .wa-card .mono { color: var(--red); }
  .wa-card__cta { display: inline-flex; align-items: center; gap: 10px; margin-top: 10px; font-weight: 600; }
  .wa-card__cta :global(svg) { width: 18px; transition: transform 0.4s var(--ease-out); }
  .wa-card:hover { background: var(--red); }
  .wa-card:hover .mono, .wa-card:hover .muted { color: var(--white); }
  .wa-card:hover .wa-card__cta :global(svg) { transform: translateX(6px); }
  .contact__details { display: grid; gap: 18px; }
  .contact__details dd { font-weight: 600; margin-top: 4px; }
  .contact__social { display: flex; gap: 18px; }

  .brief { display: grid; gap: 22px; padding-top: 4px; }
  .brief__row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
  .field { display: grid; gap: 8px; }
  .field label { font-weight: 600; font-size: 0.95rem; }
  .field label span { color: var(--red-ink); }
  .field input, .field textarea, .field select {
    width: 100%; font: inherit; color: var(--ink); background: transparent;
    border: 0; border-bottom: 1.5px solid var(--ink); border-radius: 0; padding: 12px 0;
    transition: border-color 0.3s;
  }
  .field select { appearance: none; background: linear-gradient(45deg, transparent 50%, var(--ink) 50%) calc(100% - 10px) 55% / 6px 6px no-repeat, linear-gradient(-45deg, transparent 50%, var(--ink) 50%) calc(100% - 4px) 55% / 6px 6px no-repeat; padding-right: 28px; }
  .field textarea { resize: vertical; min-height: 140px; }
  .field input:focus, .field textarea:focus, .field select:focus { outline: none; border-color: var(--red); }
  .field [aria-invalid='true'] { border-color: var(--red); }
  .consent { display: grid; grid-template-columns: 22px 1fr; gap: 12px; font-size: var(--step--1); color: var(--muted); align-items: start; }
  .consent input { width: 20px; height: 20px; margin: 2px 0 0; accent-color: var(--red); }
  .consent:has([aria-invalid='true']) { color: var(--red-ink); }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .brief__status:empty { display: none; }
  .brief__status { padding: 14px 16px; border-left: 3px solid var(--ink); background: var(--paper-2); font-size: var(--step--1); }
  .brief__status[data-kind='error'] { border-color: var(--red); color: var(--red-ink); }
  .brief .btn { justify-self: start; }
  .brief .btn:disabled { opacity: 0.6; cursor: progress; }

  @media (max-width: 860px) {
    .contact__grid { grid-template-columns: 1fr; }
    .contact__aside { position: static; }
  }
  @media (max-width: 560px) { .brief__row { grid-template-columns: 1fr; } }
</style>
