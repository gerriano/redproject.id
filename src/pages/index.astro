---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Arrow from '../components/Arrow.astro';
import ClientWall from '../components/ClientWall.astro';
import Stats from '../components/Stats.astro';
import { heroWords, painPoints, pillars, practices, steps, advantages, faqs, waLink } from '../data/site';
import { url } from '../lib/url';
import heroBand from '../assets/hero/hero-home.jpg';
import imgStrategy from '../assets/hero/hero-about-us.jpg';
import imgBuild from '../assets/hero/hero-contact.jpg';
import imgGrow from '../assets/hero/hero-stories.jpg';

const practiceImages: Record<string, ImageMetadata> = { strategy: imgStrategy, build: imgBuild, grow: imgGrow };
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base path="/">
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} slot="head" />

  <!-- HERO -->
  <section class="hero">
    <div class="hero__mark" aria-hidden="true" data-hero-mark><span></span><span></span><span></span></div>
    <div class="container hero__inner">
      <p class="eyebrow hero__eyebrow" data-hero-fade>Digital consultancy · Indonesia · 10+ years</p>
      <h1 class="display hero__title" aria-label="Digital Advisory 360°">
        <span class="hero__line"><span class="hero__line-inner">Digital</span></span>
        <span class="hero__line"><span class="hero__line-inner">Advisory</span></span>
        <span class="hero__line"><span class="hero__line-inner">360<span class="red">°</span></span></span>
      </h1>
      <div class="hero__bottom">
        <p class="lead hero__lead" data-hero-fade>
          We help SMEs and national brands make digital <span class="visually-hidden">reliable, measurable and adjustable</span><span class="cycler" data-cycler aria-hidden="true">{heroWords.map((w, i) => (<span class={`cycler__word ${i === 0 ? 'is-active' : ''}`}>{w}</span>))}</span>, from strategy to execution.
        </p>
        <div class="hero__actions" data-hero-fade>
          <a href={waLink()} class="btn btn--red" target="_blank" rel="noopener" data-magnetic data-cursor>Book a free consultation <Arrow /></a>
          <a href="#services" class="btn btn--ghost" data-cursor>See services</a>
        </div>
      </div>
      <div class="hero__meta mono" data-hero-fade>
        <span>Scroll to explore ↓</span>
        <span>Strategy · Build · Grow</span>
      </div>
    </div>
  </section>

  <!-- IMAGE BAND -->
  <section class="band" aria-label="Where strategy meets technology">
    <div class="band__media" data-parallax>
      <Image src={heroBand} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" class="band__img" />
    </div>
    <div class="container band__content">
      <p class="h2 band__text" data-split>Where strategy meets technology.</p>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="section problem">
    <div class="container problem__grid">
      <div class="problem__head">
        <p class="eyebrow">Sound familiar?</p>
        <h2 class="h2" data-split>Is your business here right now?</h2>
      </div>
      <ol class="problem__list" role="list">
        {painPoints.map((p, i) => (
          <li data-reveal>
            <span class="mono red">{String(i + 1).padStart(2, '0')}</span>
            <span>{p}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- PILLARS (pinned horizontal on desktop) -->
  <section class="pillars section--dark" data-pillars>
    <div class="pillars__pin">
      <div class="container pillars__head">
        <p class="eyebrow">Our standard</p>
        <h2 class="h3 pillars__intro">Every digital initiative we touch has to pass three tests.</h2>
      </div>
      <div class="pillars__track" data-pillars-track>
        {pillars.map((p, i) => (
          <article class="pillar">
            <span class="mono pillar__num">{String(i + 1).padStart(2, '0')} / 03</span>
            <h3 class="pillar__title">{p.title}<span class="red">.</span></h3>
            <p class="pillar__body">{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section services" id="services">
    <div class="container">
      <div class="services__head">
        <p class="eyebrow">Services</p>
        <h2 class="h2" data-split>Strategy, build<br />and growth.</h2>
        <p class="lead muted" data-reveal>One partner across the full journey, so nothing gets lost between agencies.</p>
      </div>
      <div class="practices">
        {practices.map((pr) => (
          <article class="practice" data-practice data-image={pr.id} data-cursor>
            <div class="practice__name">
              <h3>{pr.name}</h3>
              <p class="muted">{pr.lead}</p>
            </div>
            <ul class="practice__services" role="list">
              {pr.services.map((s) => (
                <li data-reveal>
                  <h4>{s.title}</h4>
                  <p class="muted">{s.body}</p>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </div>
    <div class="hover-media" aria-hidden="true" data-hover-media>
      {practices.map((pr) => (
        <Image src={practiceImages[pr.id]} alt="" width={480} height={320} data-hover-img={pr.id} />
      ))}
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process">
    <div class="container">
      <div class="process__head">
        <p class="eyebrow">How we work</p>
        <h2 class="h2" data-split>From first call<br />to measured results.</h2>
      </div>
      <ol class="process__list" role="list" data-process>
        {steps.map((s, i) => (
          <li class="step" data-reveal>
            <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="step__title">{s.step}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ol>
      <div class="process__line" aria-hidden="true"><span data-process-line></span></div>
    </div>
  </section>

  <!-- NUMBERS + CLIENTS -->
  <Stats />
  <ClientWall />

  <!-- WHY RED -->
  <section class="section why">
    <div class="container why__grid">
      <div class="why__head">
        <p class="eyebrow">Why RED Project</p>
        <h2 class="h2" data-split>A consultant that makes business easier, not heavier.</h2>
      </div>
      <div class="why__list">
        {advantages.map((a) => (
          <div class="why__item" data-reveal>
            <span class="why__plus" aria-hidden="true">+</span>
            <h3>{a.title}</h3>
            <p class="muted">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section faq" id="faq">
    <div class="container faq__grid">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2 class="h2" data-split>Questions we hear first.</h2>
        <p class="muted faq__more" data-reveal>Something else? <a href={url('/contact/')} class="link-underline red">Ask us directly</a>.</p>
      </div>
      <div class="faq__list">
        {faqs.map((f, i) => (
          <details class="faq__item" data-reveal open={i === 0}>
            <summary data-cursor><span>{f.q}</span><span class="faq__icon" aria-hidden="true"></span></summary>
            <div class="faq__answer"><p>{f.a}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(32px, 6vw, 80px)); padding-bottom: clamp(48px, 7vw, 96px); }
  .hero__inner { position: relative; display: grid; gap: clamp(24px, 3vw, 40px); }
  .hero__mark {
    position: absolute; z-index: 0; pointer-events: none;
    right: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    top: calc(var(--header-h) + env(safe-area-inset-top, 0px) + clamp(40px, 6vw, 90px));
    width: min(30vw, 440px); aspect-ratio: 1.2; display: grid; align-content: center; gap: 9%;
  }
  .hero__mark span { display: block; height: 0; padding-bottom: 15%; width: 72%; background: var(--red); transform: skewX(-36deg); transform-origin: left center; }
  .hero__mark span:nth-child(1) { margin-left: 28%; }
  .hero__mark span:nth-child(2) { margin-left: 14%; }
  @media (max-width: 900px) { .hero__mark { display: none; } }
  .hero__title { display: grid; }
  .hero__line { display: block; overflow: hidden; padding-bottom: 0.04em; }
  .hero__line-inner { display: inline-block; }
  .hero__line:nth-child(2) { padding-left: 0.9em; }
  .hero__bottom { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 28px; }
  .hero__lead { max-width: 36ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .hero__meta { display: flex; justify-content: space-between; color: var(--muted); padding-top: 20px; border-top: 1px solid var(--rule); }
  .cycler { position: relative; display: inline-grid; vertical-align: bottom; font-weight: 700; color: var(--red-ink); }
  .cycler__word { grid-area: 1 / 1; opacity: 0; transform: translateY(60%); transition: opacity 0.5s var(--ease-out), transform 0.6s var(--ease-out); }
  .cycler__word.is-active { opacity: 1; transform: none; }
  .cycler__word.is-leaving { opacity: 0; transform: translateY(-60%); }
  html:not(.js) .cycler__word:not(:first-child) { display: none; }

  /* BAND */
  .band { position: relative; height: clamp(420px, 80vh, 820px); overflow: hidden; color: var(--white); background: var(--ink); }
  .band__media { position: absolute; inset: -12% 0; }
  .band__img { width: 100%; height: 100%; object-fit: cover; }
  .band__content { position: relative; height: 100%; display: flex; align-items: flex-end; padding-bottom: clamp(32px, 6vw, 80px); }
  .band__text { max-width: 14ch; }

  /* PROBLEM */
  .problem__grid { display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(40px, 6vw, 120px); }
  .problem__head { display: grid; gap: 24px; align-content: start; position: sticky; top: calc(var(--header-h) + 40px); }
  .problem__list { display: grid; }
  .problem__list li { display: grid; grid-template-columns: 56px 1fr; gap: 16px; padding: 26px 0; border-top: 1px solid var(--rule); font-size: var(--step-1); line-height: 1.35; font-weight: 500; letter-spacing: -0.01em; }
  .problem__list li:last-child { border-bottom: 1px solid var(--rule); }
  .problem__list .mono { padding-top: 0.35em; }

  /* PILLARS */
  .pillars { position: relative; overflow: hidden; }
  .pillars__pin { padding-block: var(--section); display: grid; grid-template-columns: minmax(0, 1fr); gap: clamp(40px, 6vw, 72px); }
  .pillars__head { display: grid; gap: 20px; }
  .pillars__intro { max-width: 22ch; }
  .pillars__track { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; padding-inline: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter))); }
  .pillar { display: grid; gap: 22px; align-content: start; padding: 36px 32px 40px 0; border-top: 1px solid var(--rule-on-dark); }
  .pillar + .pillar { padding-left: 32px; border-left: 1px solid var(--rule-on-dark); }
  .pillar__num { color: var(--muted-on-dark); }
  .pillar__title { font-weight: 800; font-size: var(--step-4); line-height: 0.9; letter-spacing: -0.045em; text-transform: uppercase; }
  .pillar__body { color: var(--muted-on-dark); max-width: 38ch; font-size: var(--step-1); line-height: 1.45; }
  @media (min-width: 1024px) {
    .pillars.is-horizontal .pillars__pin { min-height: 100vh; align-content: center; }
    .pillars.is-horizontal .pillars__track { display: flex; width: max-content; gap: 0; }
    .pillars.is-horizontal .pillar { width: min(74vw, 1000px); flex-shrink: 0; padding: 40px 64px 48px 0; }
    .pillars.is-horizontal .pillar + .pillar { padding-left: 64px; }
    .pillars.is-horizontal .pillar__title { font-size: clamp(4.5rem, 8.6vw, 9.25rem); }
  }

  /* SERVICES */
  .services { position: relative; }
  .services__head { display: grid; gap: 24px; margin-bottom: clamp(48px, 6vw, 96px); }
  .practices { border-top: 1px solid var(--ink); }
  .practice { display: grid; grid-template-columns: 1fr 1.6fr; gap: clamp(24px, 4vw, 80px); padding-block: clamp(32px, 4vw, 56px); border-bottom: 1px solid var(--rule); transition: background-color 0.4s; }
  .practice__name { display: grid; gap: 12px; align-content: start; }
  .practice__name h3 { font-weight: 800; font-size: var(--step-4); line-height: 0.9; letter-spacing: -0.045em; text-transform: uppercase; transition: color 0.3s, transform 0.5s var(--ease-out); }
  .practice:hover .practice__name h3 { color: var(--red); transform: translateX(8px); }
  .practice__name p { max-width: 30ch; }
  .practice__services { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px 40px; }
  .practice__services h4 { font-size: var(--step-1); font-weight: 700; letter-spacing: -0.015em; margin-bottom: 8px; line-height: 1.2; }
  .hover-media { position: fixed; left: 0; top: 0; z-index: 20; width: 300px; aspect-ratio: 3 / 2; pointer-events: none; opacity: 0; overflow: hidden; border-radius: 4px; }
  .hover-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.3s; }
  .hover-media img.is-active { opacity: 1; }
  @media (hover: none), (max-width: 1023px) { .hover-media { display: none; } }

  /* PROCESS */
  .process { background: var(--paper-2); position: relative; }
  .process__head { display: grid; gap: 24px; margin-bottom: clamp(48px, 6vw, 88px); }
  .process__list { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; position: relative; z-index: 1; }
  .step { display: grid; gap: 14px; align-content: start; padding-top: 28px; }
  .step__num { font-family: var(--font-mono); font-size: var(--step--1); display: inline-grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; background: var(--ink); color: var(--white); }
  .step__title { font-size: var(--step-2); font-weight: 800; letter-spacing: -0.03em; line-height: 1; text-transform: uppercase; }
  .process__line { position: relative; height: 2px; background: var(--rule); order: 1; margin-bottom: -2px; }
  .process__line span { position: absolute; inset: 0; background: var(--red); transform-origin: left; transform: scaleX(var(--progress, 1)); }
  .process .container { display: flex; flex-direction: column; }
  .process__list { order: 2; }
  .process__head { order: 0; }

  /* WHY */
  .why__grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(40px, 6vw, 120px); }
  .why__head { display: grid; gap: 24px; align-content: start; }
  .why__head .h2 { font-size: var(--step-3); }
  .why__list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0; border-top: 1px solid var(--rule); }
  .why__item { display: grid; gap: 10px; align-content: start; padding: 28px 24px 32px 0; border-bottom: 1px solid var(--rule); }
  .why__item:nth-child(even) { padding-left: 24px; border-left: 1px solid var(--rule); }
  .why__item h3 { font-size: var(--step-1); font-weight: 700; letter-spacing: -0.015em; line-height: 1.2; }
  .why__plus { color: var(--red); font-weight: 800; font-size: var(--step-2); line-height: 1; }

  /* FAQ */
  .faq { padding-top: 0; }
  .faq__grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(40px, 6vw, 120px); }
  .faq__grid > div:first-child { display: grid; gap: 24px; align-content: start; }
  .faq__list { border-top: 1px solid var(--ink); }
  .faq__item { border-bottom: 1px solid var(--rule); }
  .faq__item summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 24px 0; cursor: pointer; font-weight: 700; font-size: var(--step-1); letter-spacing: -0.015em; line-height: 1.25; }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__icon { position: relative; flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--ink); transition: background-color 0.3s, box-shadow 0.3s; }
  .faq__icon::before, .faq__icon::after { content: ''; position: absolute; left: 11px; right: 11px; top: 50%; height: 1.5px; margin-top: -0.75px; background: currentColor; transition: transform 0.4s var(--ease-out); }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon { background: var(--red); box-shadow: none; color: var(--white); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__answer { padding: 0 56px 28px 0; }
  .faq__answer p { max-width: 60ch; color: var(--muted); }

  @media (max-width: 1023px) {
    .process__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .problem__grid, .why__grid, .faq__grid, .practice { grid-template-columns: 1fr; }
    .problem__head { position: static; }
    .pillars__track { grid-template-columns: 1fr; }
    .pillar + .pillar { padding-left: 0; border-left: 0; }
    .hero__line:nth-child(2) { padding-left: 0.5em; }
  }
  @media (max-width: 560px) {
    .process__list, .why__list { grid-template-columns: 1fr; }
    .why__item:nth-child(even) { padding-left: 0; border-left: 0; }
    .hero__meta span:last-child { display: none; }
    .faq__answer { padding-right: 0; }
  }
</style>
